# Frontend: copy this file to .env.local at the repository root.
# Backend canonical clarification settings belong in backend/.env; see
# backend/.env.example. Destination budget is fixed at 2. Preference defaults
# remain unconfigured until owner approval; frontend env does not supply them.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Leave empty to use the Vite /api proxy locally. Set the backend origin for production.
VITE_API_BASE_URL=
