# Frontend (Vite reads root .env.local for existing installations)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Leave empty to use the Vite /api proxy locally. Set the backend origin for production.
VITE_API_BASE_URL=

# Backend: copy these settings to backend/.env
APP_NAME=Travelio
LOG_LEVEL=INFO
# AI JSONL path relative to ai/, with rotating backups.
AI_LOG_FILE=logs/execution.jsonl
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

LLM_PROVIDER=mock
# Real chat: set LLM_PROVIDER=openai, OPENAI_MODEL and OPENAI_API_KEY.
LLM_MODEL=mock-model
LLM_API_KEY=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=30
AGENT_RUNTIME_ENABLED=false

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# LangGraph limits (stored with each run; resume keeps the original limits).
GRAPH_MAX_CLARIFICATIONS=3
GRAPH_MAX_REVISIONS=8
GRAPH_MAX_RETRIES=3
GRAPH_MAX_TRANSITIONS=80
GRAPH_MAX_CANDIDATES=400
