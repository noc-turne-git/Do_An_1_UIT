{
  "$defs": {
    "CostRange": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "CostRange",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "severity": {
          "enum": [
            "hard",
            "soft",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day"
        },
        "place_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Id"
        },
        "actual": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "expected": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "target": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "deadline": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        },
        "cost_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Basis"
        }
      },
      "required": [
        "type",
        "rule",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Recomputed": {
      "additionalProperties": false,
      "properties": {
        "cost_in_scope": {
          "$ref": "#/$defs/CostRange"
        },
        "budget_limit": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Budget Limit"
        },
        "total_travel_minutes": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Total Travel Minutes",
          "type": "integer"
        },
        "total_scheduled_places": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Total Scheduled Places",
          "type": "integer"
        }
      },
      "required": [
        "cost_in_scope",
        "budget_limit",
        "total_travel_minutes",
        "total_scheduled_places"
      ],
      "title": "Recomputed",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "trip_id": {
      "format": "uuid",
      "title": "Trip Id",
      "type": "string"
    },
    "is_valid": {
      "title": "Is Valid",
      "type": "boolean"
    },
    "violations": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Violations",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Warnings",
      "type": "array"
    },
    "checked_rules": {
      "items": {
        "type": "string"
      },
      "title": "Checked Rules",
      "type": "array"
    },
    "recomputed": {
      "$ref": "#/$defs/Recomputed"
    },
    "suggested_action": {
      "enum": [
        "accept",
        "replan",
        "ask_user",
        "fail"
      ],
      "title": "Suggested Action",
      "type": "string"
    }
  },
  "required": [
    "trip_id",
    "is_valid",
    "violations",
    "warnings",
    "checked_rules",
    "recomputed",
    "suggested_action"
  ],
  "title": "ValidationResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
