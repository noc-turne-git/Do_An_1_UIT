{
  "$defs": {
    "ArtifactReferences": {
      "additionalProperties": false,
      "properties": {
        "trip_request_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trip Request Id"
        },
        "destination_result_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Result Id"
        },
        "time_constraints_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Constraints Id"
        },
        "candidates_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidates Id"
        },
        "costed_candidates_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Costed Candidates Id"
        },
        "planning_input_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planning Input Id"
        },
        "itinerary_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Itinerary Id"
        },
        "validation_result_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Result Id"
        }
      },
      "title": "ArtifactReferences",
      "type": "object"
    },
    "CandidateRegion": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "title": "City",
          "type": "string"
        },
        "province": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Province"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        }
      },
      "required": [
        "city",
        "reason"
      ],
      "title": "CandidateRegion",
      "type": "object"
    },
    "ConstraintProposal": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Proposal Id",
          "type": "string"
        },
        "fields": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "current_values": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Values"
        },
        "proposed_values": {
          "additionalProperties": true,
          "title": "Proposed Values",
          "type": "object"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "fields",
        "proposed_values",
        "reason"
      ],
      "title": "ConstraintProposal",
      "type": "object"
    },
    "DestinationEpisode": {
      "additionalProperties": false,
      "properties": {
        "selection_intent": {
          "default": "UNSPECIFIED",
          "enum": [
            "EXPLICIT",
            "ANY_DESTINATION",
            "DELEGATE_SELECTION",
            "USER_UNKNOWN",
            "UNSPECIFIED",
            "ANY",
            "UNKNOWN"
          ],
          "title": "Selection Intent",
          "type": "string"
        },
        "selection_authority": {
          "default": "none",
          "enum": [
            "none",
            "user",
            "delegated"
          ],
          "title": "Selection Authority",
          "type": "string"
        },
        "selection_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectionProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "destination_round": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Destination Round",
          "type": "integer"
        },
        "max_destination_rounds": {
          "default": 2,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Destination Rounds",
          "type": "integer"
        },
        "final_resolve_status": {
          "default": "not_started",
          "enum": [
            "not_started",
            "claimed",
            "completed"
          ],
          "title": "Final Resolve Status",
          "type": "string"
        },
        "final_resolve_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Resolve Id"
        },
        "final_resolve_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/DestinationResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "episode_id",
        "request_id"
      ],
      "title": "DestinationEpisode",
      "type": "object"
    },
    "DestinationRecovery": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "fields": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "constraint_proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConstraintProposal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "reason",
        "fields"
      ],
      "title": "DestinationRecovery",
      "type": "object"
    },
    "DestinationResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "request_type": {
          "enum": [
            "EXPLICIT",
            "IMPLICIT",
            "AMBIGUOUS",
            "INSUFFICIENT"
          ],
          "title": "Request Type",
          "type": "string"
        },
        "selected_region": {
          "anyOf": [
            {
              "$ref": "#/$defs/Region"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_status": {
          "enum": [
            "selected",
            "needs_user_choice",
            "no_valid_candidate",
            "needs_more_info"
          ],
          "title": "Selection Status",
          "type": "string"
        },
        "selection_reason": {
          "title": "Selection Reason",
          "type": "string"
        },
        "candidate_regions": {
          "items": {
            "$ref": "#/$defs/CandidateRegion"
          },
          "title": "Candidate Regions",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "information_requests": {
          "items": {
            "$ref": "#/$defs/InformationRequest"
          },
          "title": "Information Requests",
          "type": "array"
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/DestinationRecovery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "selected_candidate_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Candidate Id"
        },
        "selection_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectionProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "selection_method": {
          "anyOf": [
            {
              "enum": [
                "USER_EXPLICIT",
                "USER_CHOICE",
                "DELEGATED",
                "ANY_DEFAULT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Method"
        }
      },
      "required": [
        "request_type",
        "selected_region",
        "selection_status",
        "selection_reason",
        "candidate_regions",
        "missing_fields"
      ],
      "title": "DestinationResult",
      "type": "object"
    },
    "InformationRequest": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "trip_request",
            "destination_info"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "fields": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "fields",
        "reason"
      ],
      "title": "InformationRequest",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "title": "City",
          "type": "string"
        },
        "province": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Province"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        }
      },
      "required": [
        "city"
      ],
      "title": "Region",
      "type": "object"
    },
    "SelectionProvenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "user",
            "default",
            "inferred"
          ],
          "title": "Source",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Evidence",
          "type": "string"
        },
        "episode_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Id"
        },
        "question_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Id"
        }
      },
      "required": [
        "source",
        "evidence"
      ],
      "title": "SelectionProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Small runtime references/counters; histories and payloads are persisted separately.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "trip_id": {
      "format": "uuid",
      "title": "Trip Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "parsing",
        "clarifying",
        "planning",
        "validating",
        "awaiting_relaxation",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "current_step": {
      "enum": [
        "request_parser",
        "destination_agent",
        "constraint_planner",
        "place_agent",
        "budget_module",
        "planning_input_builder",
        "planning_engine",
        "validator",
        "explainer"
      ],
      "title": "Current Step",
      "type": "string"
    },
    "completed_steps": {
      "items": {
        "enum": [
          "request_parser",
          "destination_agent",
          "constraint_planner",
          "place_agent",
          "budget_module",
          "planning_input_builder",
          "planning_engine",
          "validator",
          "explainer"
        ],
        "type": "string"
      },
      "title": "Completed Steps",
      "type": "array"
    },
    "artifacts": {
      "$ref": "#/$defs/ArtifactReferences"
    },
    "clarification_round": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Clarification Round",
      "type": "integer"
    },
    "max_clarification_rounds": {
      "default": 3,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Max Clarification Rounds",
      "type": "integer"
    },
    "destination_round": {
      "default": 0,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Destination Round",
      "type": "integer"
    },
    "max_destination_rounds": {
      "default": 2,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Max Destination Rounds",
      "type": "integer"
    },
    "destination_episode": {
      "anyOf": [
        {
          "$ref": "#/$defs/DestinationEpisode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pending_fields": {
      "items": {
        "type": "string"
      },
      "title": "Pending Fields",
      "type": "array"
    },
    "retry_count": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "trip_id",
    "status",
    "current_step",
    "completed_steps",
    "artifacts",
    "clarification_round",
    "pending_fields",
    "retry_count"
  ],
  "title": "WorkflowState",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
