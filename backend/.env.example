APP_NAME=Travel Planning API
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional. Use a PostgreSQL/Supabase connection string with URL-encoded password.
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Integration tests only: dedicated empty disposable database, never production.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/travel_test

# Persistence API authentication: verified by Supabase Auth /auth/v1/user.
# Use the project's publishable key (or legacy anon key), not a service role key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# TEST_DATABASE_URL is local-only; database name must contain test and DB must be empty.
# Do not run Alembic 0001 against the new 19-table schema.

# LangGraph limits (stored with each run; resume keeps the original limits).
GRAPH_MAX_CLARIFICATIONS=3
GRAPH_MAX_REVISIONS=8
GRAPH_MAX_RETRIES=3
GRAPH_MAX_TRANSITIONS=80
GRAPH_MAX_CANDIDATES=400
