APP_NAME=Travelio
LOG_LEVEL=INFO
# AI JSONL path relative to ai/, with rotating backups.
AI_LOG_FILE=logs/execution.jsonl
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

LLM_PROVIDER=mock
# Real chat: set LLM_PROVIDER=openai, OPENAI_MODEL and OPENAI_API_KEY.
LLM_MODEL=mock-model
LLM_API_KEY=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=30
AGENT_RUNTIME_ENABLED=false

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# LangGraph limits (stored with each run; resume keeps the original limits).
GRAPH_MAX_CLARIFICATIONS=3
# Canonical clarification configuration only; runtime adoption is a later step.
# Fixed policy: values other than 2 are rejected, not silently applied.
MAX_DESTINATION_ROUNDS=2
# Optional JSON overrides; only these TripRequest defaults are permitted.
CLARIFICATION_DEFAULTS={"travelers.children":0}
# Unspecified budget amount/scope remain null; they are not defaults.
# Preferences remain unconfigured until owner-approved values are available.
# Optional CLARIFICATION_PREFERENCE_DEFAULTS JSON requires approved_by, interests,
# pace and transport_modes. Do not use placeholder preference values.
GRAPH_MAX_REVISIONS=8
GRAPH_MAX_RETRIES=3
GRAPH_MAX_TRANSITIONS=80
GRAPH_MAX_CANDIDATES=400
